{
  "name": "@mite/family-electron",
  "productName": "Mite Family",
  "private": true,
  "version": "0.1.0",
  "description": "Mite family-side Windows application",
  "author": "Mite",
  "main": "dist-electron/main/main.js",
  "config": {
    "forge": "./forge.config.cjs"
  },
  "scripts": {
    "dev": "node ../../scripts/dev-electron.mjs . 5174",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build:renderer": "vite build --config vite.renderer.config.mts",
    "build": "npm run build:electron && npm run build:renderer",
    "typecheck": "tsc -p tsconfig.electron.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "package": "npm run build && electron-forge package",
    "make": "npm run build && electron-forge make"
  },
  "dependencies": {
    "@mite/client-api": "*",
    "@mite/client-core": "*",
    "@mite/ui": "*",
    "livekit-client": "^2.22.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "electron": "^44.1.1"
  }
}
