# Add this inside the existing priv.chi-llenge.com :443 VirtualHost.
# Keep the ProxyPass exclusion before any broader /mite/ ProxyPass rule.
ProxyPass "/mite/pwa/" "!"
ProxyPass "/mite/pwa" "!"
RedirectMatch 301 "^/mite/pwa$" "/mite/pwa/"
Alias "/mite/pwa/" "/var/www/mite-family-pwa/current/"

<Directory "/var/www/mite-family-pwa/">
    Require all granted
    Options -Indexes +SymLinksIfOwnerMatch
    AllowOverride None
    DirectoryIndex index.html
    Header always set Content-Security-Policy "frame-ancestors 'none'"

    <FilesMatch "^(?:index\.html|sw\.js|manifest\.webmanifest|icon\.svg)$">
        Header always set Cache-Control "no-cache"
    </FilesMatch>
</Directory>

<LocationMatch "^/mite/pwa/assets/">
    Header always set Cache-Control "public, max-age=31536000, immutable"
</LocationMatch>
