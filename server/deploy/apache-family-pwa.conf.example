# Add this inside the existing priv.chi-llenge.com :443 VirtualHost.
# Keep the ProxyPass exclusion before any broader /mite/ ProxyPass rule.
ProxyPass "/mite/family-pwa/" "!"
ProxyPass "/mite/family-pwa" "!"
RedirectMatch 301 "^/mite/family-pwa$" "/mite/family-pwa/"
Alias "/mite/family-pwa/" "/var/www/mite-family-pwa/current/"

<Directory "/var/www/mite-family-pwa/">
    Require all granted
    Options -Indexes +SymLinksIfOwnerMatch
    AllowOverride None
    DirectoryIndex index.html

    <FilesMatch "^(?:index\.html|sw\.js|manifest\.webmanifest|icon\.svg)$">
        Header always set Cache-Control "no-cache"
    </FilesMatch>
</Directory>

<LocationMatch "^/mite/family-pwa/assets/">
    Header always set Cache-Control "public, max-age=31536000, immutable"
</LocationMatch>
