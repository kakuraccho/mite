PORT=3000
MITE_ENV=production
DATABASE_URL=postgresql://postgres:password@example.supabase.co:5432/postgres
SUPABASE_URL=https://example.supabase.co
SUPABASE_SECRET_KEY=change-me
SUPABASE_STORAGE_BUCKET=mite-artifacts
DEMO_USER_TOKEN=change-me-user
DEMO_FAMILY_TOKEN=change-me-family
LIVEKIT_URL=wss://example.livekit.cloud
LIVEKIT_API_KEY=change-me
LIVEKIT_API_SECRET=change-me
# Geminiのキーなしで操作確認: MITE_ENV=development と AI_PROVIDER=mock
# mockでは以下のAI_BASE_URL / GEMINI_API_KEY / AI_MODEL / AI_PROMPT_VERSIONは不要
AI_PROVIDER=gemini
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_API_KEY=change-me
AI_MODEL=gemini-3.8-flash
AI_PROMPT_VERSION=v2
CLIENT_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://127.0.0.1:5173,http://127.0.0.1:5174,http://127.0.0.1:5175,mite-user://app,mite-family://app
# 公開PWAでは既存値へ https://priv.chi-llenge.com を追加する
PRESENCE_ONLINE_AFTER_SECONDS=60
PRESENCE_OFFLINE_AFTER_SECONDS=90
PRESENCE_RECONNECT_AFTER_SECONDS=600
# 3項目をすべて設定した場合だけWeb Pushを有効化する
# WEB_PUSH_VAPID_PUBLIC_KEY=base64url-p256-public-key
# WEB_PUSH_VAPID_PRIVATE_KEY=base64url-p256-private-key
# WEB_PUSH_SUBJECT=mailto:family@example.com
